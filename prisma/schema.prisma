generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Options to chooose from for a role
enum Role {
  STUDENT
  RECRUITER
  EXPLORER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  dateofBirth    DateTime?
  hashedPassword String?
  role           Role      @default(EXPLORER)
  skills         String[]  @default([])

  accounts      Account[]
  sessions      Session[]
  emailVerified DateTime?
  image         String?

  resetToken       String?
  resetTokenExpiry DateTime?

  college      String?
  resumeLink   String?
  resumeUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedInternships SavedInternship[]

  company      Company?
  applications NativeApplication[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Internship {
  id             String            @id
  title          String
  company        String
  description    String            @db.Text
  location       String
  stipend        String?
  duration       String?
  employmentType String?
  startDate      DateTime?
  skills         String[]
  applyLink      String            @db.Text
  sourcePlatform String?
  postedAt       DateTime?
  fetchedAt      DateTime
  createdAt      DateTime          @default(now())
  savedBy        SavedInternship[]
}

model SavedInternship {
  id                 String            @id @default(cuid())
  userId             String
  internshipId       String
  savedAt            DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship         Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  nativeInternshipId String?
  nativeInternship   NativeInternship? @relation(fields: [nativeInternshipId], references: [id], onDelete: Cascade)

  @@unique([userId, internshipId])
}

model Company {
  id          String  @id @default(cuid())
  name        String
  website     String?
  description String? @db.Text
  logoUrl     String?

  recruiterId String @unique
  recruiter   User   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  internships NativeInternship[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model NativeInternship {
  id               String            @id @default(cuid())
  companyId        String
  title            String
  location         String
  stipend          String?
  duration         String?
  employmentType   String?
  description      String            @db.Text
  skills           String[]
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  savedInternships SavedInternship[]

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications NativeApplication[]
}

model NativeApplication {
  id           String   @id @default(cuid())
  studentId    String
  internshipId String
  coverLetter  String?  @db.Text
  status       String   @default("PENDING")
  appliedAt    DateTime @default(now())

  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship NativeInternship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
}
